{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "tailwindCSS.classFunctions": ["cn", "clsx"],
  "css.lint.unknownAtRules": "ignore",
  "search.exclude": {
    "**/.next": true,
    "**/pnpm-lock.yaml": true
  },
  "workbench.statusBar.visible": true,
  "workbench.colorCustomizations": {
    "statusBar.background": "#5b8dfb",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#5b8dfb",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#5b8dfb",
    "statusBar.debuggingForeground": "#000000",
    "titleBar.activeBackground": "#5b8dfb",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#5b8dfb",
    "titleBar.inactiveForeground": "#000000",
    "titleBar.border": "#5b8dfb"
  }
}
